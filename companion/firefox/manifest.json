{
  "manifest_version": 2,
  "name": "JD Turnstile Companion",
  "short_name": "JD Turnstile",
  "version": "1.4.0",
  "description": "Solves AnkerGames Cloudflare Turnstile in your browser and streams the CDN file into JDownloader via a localhost relay. Cloudflare sees a real browser; JD manages the download.",
  "author": "benjarogit",
  "homepage_url": "https://github.com/benjarogit/jd2plugin-ankergames-download",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "downloads",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "alarms",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["update-check.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "http://[::1]/*"
      ],
      "js": ["local-hook.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://ankergames.net/*",
        "*://*.ankergames.net/*"
      ],
      "js": ["ankergames-hook.js", "cdn-pipe.js"],
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_title": "JD Turnstile Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jd-turnstile-companion@benjarogit.github.io",
      "strict_min_version": "109.0",
      "update_url": "https://raw.githubusercontent.com/benjarogit/jd2plugin-ankergames-download/main/updates/firefox.json"
    }
  }
}
