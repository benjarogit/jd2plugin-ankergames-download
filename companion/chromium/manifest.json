{
  "manifest_version": 3,
  "name": "JD Turnstile Companion",
  "short_name": "JD Turnstile",
  "version": "1.0.2",
  "description": "Solves AnkerGames Cloudflare Turnstile in your browser and streams the CDN file into JDownloader via a localhost relay.",
  "author": "benjarogit",
  "homepage_url": "https://github.com/benjarogit/jd2plugin-ankergames-download",
  "update_url": "https://raw.githubusercontent.com/benjarogit/jd2plugin-ankergames-download/main/updates/chromium.xml",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "permissions": [
    "tabs",
    "downloads",
    "scripting",
    "webNavigation",
    "declarativeNetRequest",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "*://ankergames.net/*",
    "*://*.ankergames.net/*",
    "*://dlproxy.uk/*",
    "*://*.dlproxy.uk/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*",
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_dlproxy_hold",
        "enabled": true,
        "path": "dnr-rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["hold.html"],
      "matches": ["*://dlproxy.uk/*", "*://*.dlproxy.uk/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "http://[::1]/*"
      ],
      "js": [
        "local-hook.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://ankergames.net/*",
        "*://*.ankergames.net/*"
      ],
      "js": [
        "ankergames-hook.js",
        "cdn-pipe.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "JD Turnstile Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
